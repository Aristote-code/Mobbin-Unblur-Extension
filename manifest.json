{
  "manifest_version": 3,
  "name": "ScreenClear for Mobbin",
  "version": "1.1.1",
  "description": "Improves eligible Mobbin image previews and hides the large upgrade banner. Unofficial and not affiliated with Mobbin.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "ScreenClear for Mobbin",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://mobbin.com/*", "https://www.mobbin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
